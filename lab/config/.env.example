# Config local de LAB. Fases 1 y 2 no usan ninguna API key. Fase 3
# (Media Agent) necesita credenciales reales del/de los provider(s) que se
# vayan a usar.
#
# Regla de seguridad (docs/LAB_SECURITY.md): este archivo es SOLO
# plantilla, nunca lleva valores reales. Copiar a lab/config/.env (sin
# .example) y completar ahí — ese archivo está en .gitignore, nunca se
# commitea ni se pega en el chat.

# Qué provider usa /lab-generate-media por default cuando no se pasa
# --provider explícito. Valores válidos: gemini | cloudflare.
LAB_MEDIA_PROVIDER=gemini

# --- Provider: Gemini (obligatoria si LAB_MEDIA_PROVIDER=gemini) ---
GEMINI_API_KEY=

# Opcional — override del modelo de imagen (default: gemini-3.1-flash-image,
# ver lab/config/settings.py :: GEMINI_IMAGE_MODEL):
# LAB_GEMINI_IMAGE_MODEL=

# --- Provider: Cloudflare Workers AI / FLUX.1 schnell (obligatorias si LAB_MEDIA_PROVIDER=cloudflare) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Opcional — override del modelo (default: @cf/black-forest-labs/flux-1-schnell,
# ver lab/config/settings.py :: CLOUDFLARE_IMAGE_MODEL). flux-2-dev quedó
# descartado por timeouts reales del lado de Cloudflare — no usar.
# CLOUDFLARE_IMAGE_MODEL=
